<?xml version="1.0" encoding="utf-8"?>
<!-- AutoBridge as the car's digital assistant: the steering-wheel voice button opens Android Auto's
     Assistant. The platform requires both services. -->
<voice-interaction-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:sessionService="dev.autobridge.VoiceSessionService"
    android:recognitionService="dev.autobridge.VoiceRecognitionService"
    android:supportsAssist="true"
    android:supportsLaunchVoiceAssistFromKeyguard="false"
    android:supportsLocalInteraction="false" />
